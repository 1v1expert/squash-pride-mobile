# Dockerfile для деплоя pre-built артефактов.
# Ожидает, что папка dist/ уже существует в контексте сборки.
# Используй build-webapp.sh для локальной сборки и упаковки.

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
